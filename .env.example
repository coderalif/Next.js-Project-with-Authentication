BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For persistent production authentication, configure a managed PostgreSQL database.
# Leave DATABASE_URL empty to use the local SQLite file.
DATABASE_URL=
BETTER_AUTH_DB_PATH=./auth.sqlite

# Configure both values for each provider to enable its social sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
