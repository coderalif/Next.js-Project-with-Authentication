BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=your-auth-url-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave DATABASE_URL empty only for local development with SQLite.
# Serverless production deployments require a persistent PostgreSQL database.
DATABASE_URL=
BETTER_AUTH_DB_PATH=./auth.sqlite

# Configure both values for each provider to enable its social sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
